# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Required: channel ID where book-club commands are allowed
BOOK_CHANNEL_ID=

# Required: role ID pinged by /swap when a new book starts
BOOK_ROLE_ID=

# Optional: comma-separated list of Discord user IDs who can run admin commands
ADMIN_IDS=

# Optional: path to the SQLite database (default: data/bookbot.db)
DATABASE_PATH=data/bookbot.db
